{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "effect/*": ["../../../ts/node_modules/effect/dist/dts/*"]
    }
  },
  "include": ["*.d.ts", "conformance.ts"]
}
