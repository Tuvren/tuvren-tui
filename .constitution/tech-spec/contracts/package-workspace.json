{
  "name": "@tuvren/workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["ts", "packages/*"],
  "scripts": {
    "build:package": "bun run scripts/build-package.ts",
    "check:contracts": "bun run scripts/check-contracts.ts",
    "check:capability-map": "bun run scripts/check-capability-map.ts",
    "check:release-candidate": "bun run scripts/check-release-candidate.ts",
    "test:semantic": "bun test ts/test-semantic.test.ts",
    "test:terminal": "bun test ts/test-terminal.test.ts",
    "test:platform-smoke": "bun run scripts/test-platform-smoke.ts",
    "test:release-package": "bun run scripts/test-release-package.ts",
    "bench:envelope": "bun run benchmarks/envelope.ts",
    "bench:comparative": "bun run benchmarks/comparative.ts",
    "bench:devtools": "bun run benchmarks/devtools.ts",
    "study:onboarding": "bun run scripts/study-onboarding.ts",
    "study:style-defect": "bun run scripts/study-style-defect.ts"
  }
}
