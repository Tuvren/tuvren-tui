{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuvren.dev/schema/release-manifest/1.0.0/schema.json",
  "title": "Tuvren atomic release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageVersion",
    "abi",
    "sourceCommit",
    "createdAt",
    "provenance",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "provenance": { "type": "string", "format": "uri" },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "version",
          "sha256",
          "sizeBytes",
          "provenance",
          "sourceRevision"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "public-package",
              "linux-x64",
              "linux-arm64",
              "darwin-arm64",
              "darwin-x64",
              "win32-x64"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "provenance": { "type": "string", "format": "uri" },
          "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "public-package" } },
            "required": ["kind"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "linux-x64" } },
            "required": ["kind"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "linux-arm64" } },
            "required": ["kind"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "darwin-arm64" } },
            "required": ["kind"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "darwin-x64" } },
            "required": ["kind"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": { "kind": { "const": "win32-x64" } },
            "required": ["kind"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
