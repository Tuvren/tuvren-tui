{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuvren.dev/schema/benchmark-result/1.0.0/schema.json",
  "title": "Tuvren benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "fixture",
    "implementation",
    "versions",
    "hardware",
    "terminalProfile",
    "method",
    "metricDefinitions",
    "samples",
    "summary",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "suite": { "type": "string", "minLength": 1 },
    "fixture": { "type": "string", "minLength": 1 },
    "implementation": { "type": "string", "minLength": 1 },
    "versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "cores", "memoryBytes", "os", "architecture"],
      "properties": {
        "cpu": { "type": "string" },
        "cores": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "os": { "type": "string" },
        "architecture": { "type": "string" }
      }
    },
    "terminalProfile": {
      "$ref": "https://tuvren.dev/schema/terminal-profile/1.0.0/schema.json"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupIterations", "sampleCount", "statistic"],
      "properties": {
        "warmupIterations": { "type": "integer", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "statistic": { "enum": ["p50", "p95", "p99", "mean"] }
      }
    },
    "metricDefinitions": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": { "$ref": "#/$defs/metricDefinition" }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engineNanos",
          "writeNanos",
          "inputToSurfaceNanos",
          "residentBytes",
          "metrics"
        ],
        "properties": {
          "engineNanos": { "type": "integer", "minimum": 0 },
          "writeNanos": { "type": "integer", "minimum": 0 },
          "inputToSurfaceNanos": { "type": "integer", "minimum": 0 },
          "residentBytes": { "type": "integer", "minimum": 0 },
          "metrics": {
            "type": "object",
            "maxProperties": 256,
            "additionalProperties": { "$ref": "#/$defs/metricSampleValue" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineNanos",
        "writeNanos",
        "inputToSurfaceNanos",
        "residentBytes",
        "metrics"
      ],
      "properties": {
        "engineNanos": { "type": "number", "minimum": 0 },
        "writeNanos": { "type": "number", "minimum": 0 },
        "inputToSurfaceNanos": { "type": "number", "minimum": 0 },
        "residentBytes": { "type": "number", "minimum": 0 },
        "metrics": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": { "$ref": "#/$defs/metricSummary" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/evidenceCheck" }
    }
  },
  "$defs": {
    "metricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "valueType", "description"],
      "properties": {
        "unit": {
          "enum": [
            "nanoseconds",
            "bytes",
            "count",
            "ratio",
            "percent",
            "calls",
            "allocations",
            "boolean"
          ]
        },
        "valueType": { "enum": ["number", "integer", "boolean"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "metricSampleValue": {
      "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "boolean" }]
    },
    "metricSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statistic", "value"],
      "properties": {
        "statistic": {
          "enum": ["p50", "p95", "p99", "mean", "min", "max", "sum", "exact"]
        },
        "value": { "$ref": "#/$defs/metricSampleValue" }
      }
    },
    "jsonScalar": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 4096 }
      ]
    },
    "evidenceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "passed": { "type": "boolean" },
        "actual": { "$ref": "#/$defs/jsonScalar" },
        "expected": { "$ref": "#/$defs/jsonScalar" },
        "message": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
