{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuvren.dev/schema/benchmark-result/1.0.0/schema.json",
  "title": "Tuvren benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "fixture",
    "implementation",
    "versions",
    "hardware",
    "terminalProfile",
    "method",
    "samples",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "suite": { "type": "string", "minLength": 1 },
    "fixture": { "type": "string", "minLength": 1 },
    "implementation": { "type": "string", "minLength": 1 },
    "versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "cores", "memoryBytes", "os", "architecture"],
      "properties": {
        "cpu": { "type": "string" },
        "cores": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "string", "pattern": "^[0-9]+$" },
        "os": { "type": "string" },
        "architecture": { "type": "string" }
      }
    },
    "terminalProfile": {
      "$ref": "https://tuvren.dev/schema/terminal-profile/1.0.0/schema.json"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupIterations", "sampleCount", "statistic"],
      "properties": {
        "warmupIterations": { "type": "integer", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "statistic": { "enum": ["p50", "p95", "p99", "mean"] }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engineNanos",
          "writeNanos",
          "inputToSurfaceNanos",
          "residentBytes"
        ],
        "properties": {
          "engineNanos": { "type": "integer", "minimum": 0 },
          "writeNanos": { "type": "integer", "minimum": 0 },
          "inputToSurfaceNanos": { "type": "integer", "minimum": 0 },
          "residentBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineNanos",
        "writeNanos",
        "inputToSurfaceNanos",
        "residentBytes"
      ],
      "properties": {
        "engineNanos": { "type": "number", "minimum": 0 },
        "writeNanos": { "type": "number", "minimum": 0 },
        "inputToSurfaceNanos": { "type": "number", "minimum": 0 },
        "residentBytes": { "type": "number", "minimum": 0 }
      }
    }
  }
}
