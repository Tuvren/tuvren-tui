{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuvren.dev/schema/diagnostic-snapshot/1.0.0/schema.json",
  "title": "Tuvren diagnostic snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "contextId",
    "transactionId",
    "renderRequestId",
    "surface",
    "semanticTree"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "contextId": { "type": "string", "minLength": 1 },
    "transactionId": { "type": "string", "pattern": "^[0-9]+$" },
    "renderRequestId": { "type": "string", "pattern": "^[0-9]+$" },
    "traceBasis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "atSequence"],
          "properties": {
            "kind": { "const": "retained" },
            "atSequence": { "type": "string", "pattern": "^[0-9]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "boundarySequence"],
          "properties": {
            "kind": { "const": "wrap-baseline" },
            "boundarySequence": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        }
      ]
    },
    "surface": { "$ref": "#/$defs/surface" },
    "semanticTree": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/semanticNode" }
    },
    "issues": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "cellEncoding", "cellRuns"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 3000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cellEncoding": { "const": "row-major-rle-v1" },
        "cellRuns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000000,
          "items": { "$ref": "#/$defs/cellRun" }
        },
        "cursor": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "visible"],
              "properties": {
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "visible": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "cellRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "grapheme", "width", "continuation", "style"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 3000000 },
        "grapheme": { "type": "string" },
        "width": { "type": "integer", "minimum": 0, "maximum": 8 },
        "continuation": { "type": "boolean" },
        "style": { "type": "object" }
      }
    },
    "semanticNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "children", "states", "relationships"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "value": {
          "anyOf": [{ "type": "string" }, { "type": "number" }]
        },
        "states": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "anyOf": [
              { "type": "boolean" },
              { "type": "string" },
              { "type": "number" }
            ]
          }
        },
        "children": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "relationships": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "type": "array",
            "maxItems": 10000,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "operation",
        "phase",
        "source",
        "cause",
        "preceding",
        "traceInterval",
        "message",
        "remediation",
        "actions"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "component": { "type": "string" },
        "phase": {
          "enum": [
            "input",
            "event",
            "command",
            "effect",
            "reconcile",
            "transaction",
            "mutation",
            "layout",
            "text",
            "render",
            "terminal",
            "cleanup"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["application", "sdk", "native", "terminal"] },
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 }
          }
        },
        "cause": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "summary"],
          "properties": {
            "kind": {
              "enum": ["error", "panic", "terminal", "validation", "unknown"]
            },
            "summary": { "type": "string", "maxLength": 4096 }
          }
        },
        "preceding": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "eventId": { "type": "string", "pattern": "^[0-9]+$" },
                "commandId": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "traceInterval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startSequence", "endSequence"],
          "properties": {
            "startSequence": { "type": "string", "pattern": "^[0-9]+$" },
            "endSequence": { "type": "string", "pattern": "^[0-9]+$" }
          }
        },
        "message": { "type": "string" },
        "remediation": { "type": "string" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["report", "trace", "restart"] }
        }
      }
    }
  }
}
